# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# Password for the PostgreSQL database
DB_PASSWORD=choose-a-strong-password

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Optional: enables the "Ask" feature (plain-English questions about employees).
# Get a key at https://console.anthropic.com/ — leave blank to run without it.
ANTHROPIC_API_KEY=
